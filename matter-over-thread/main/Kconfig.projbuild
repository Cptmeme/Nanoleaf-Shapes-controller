menu "Nanoleaf Shapes panel bus"

    config NANOLEAF_BUS_TX_GPIO
        int "Panel bus TX GPIO"
        range 0 48
        default 26 if IDF_TARGET_ESP32C5
        default 3 if IDF_TARGET_ESP32C6
        default 0
        help
            Drives the transmit buffer (U4). ESPC5-12: GPIO26, WT0132C6-S5: GPIO3.

    config NANOLEAF_BUS_RX_GPIO
        int "Panel bus RX GPIO"
        range 0 48
        default 27 if IDF_TARGET_ESP32C5
        default 10 if IDF_TARGET_ESP32C6
        default 1
        help
            Reads the receive buffer (U3). ESPC5-12: GPIO27, WT0132C6-S5: GPIO10.

    config NANOLEAF_BUS_RC_GPIO
        int "One-shot (RC) node GPIO, -1 if not connected"
        range -1 48
        default 6 if IDF_TARGET_ESP32C5
        default 7 if IDF_TARGET_ESP32C6
        default -1
        help
            Kept as a high-impedance input so the hardware one-shot controls the transmit buffer.

    # The switches are on the BACK of the board and the case shows that face to the room, so the view is
    # mirrored: the highest board x is the LEFTMOST button. Left to right as somebody at the wall sees it,
    # that is SW6 (x 113.90, the large cap), SW4 (x 67.18) and SW3 (x 49.85). Only the power button has a
    # function name in the schematic; the other two are named for where they are, so they stay true if
    # these assignments change.
    #
    # Each switch shorts its pin to GND against nothing but a debounce cap, so the internal pull-ups are
    # enabled and all three are active low.

    config NANOLEAF_BTN_POWER_GPIO
        int "Power button GPIO, -1 if not fitted"
        range -1 48
        default 10 if IDF_TARGET_ESP32C5
        default -1
        help
            The leftmost button, the large cap: SW6, module footprint pad 20, net BTN_PWR. Toggles the light.

    config NANOLEAF_BTN_COLOUR_GPIO
        int "Colour cycle button GPIO, -1 if not fitted"
        range -1 48
        default 1 if IDF_TARGET_ESP32C5
        default -1
        help
            The middle button: SW4, module footprint pad 2, net BTN_LEFT. Steps forward through the
            colour cycle, wrapping past the rainbow back to the first colour.

    config NANOLEAF_BTN_BRIGHT_GPIO
        int "Brightness button GPIO, -1 if not fitted"
        range -1 48
        default 0 if IDF_TARGET_ESP32C5
        default -1
        help
            The rightmost button: SW3, module footprint pad 1, net BTN_RIGHT. A tap steps the brightness
            up 10%, wrapping from 100% back to 10%. Holding it ramps smoothly up to 100% and stops
            there, keeping whatever level it had reached when released.

    config NANOLEAF_TRANSITION
        int "Panel fade time per colour change"
        range 0 255
        default 1
        help
            The chunk fade time T sent with every colour frame. Units are unverified (probably 100 ms).

endmenu
