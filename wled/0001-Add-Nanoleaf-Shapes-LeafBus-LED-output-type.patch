+    bool clash = false;
+    for (int i = 0; i < n && !clash; i++) {
+      int col = (int)lroundf((xs[i] - minX) / step), row = (int)lroundf((maxY - ys[i]) / step);
+      cells[i] = (uint16_t)(row * w + col);
+      for (int j = 0; j < i; j++) if (cells[j] == cells[i]) { clash = true; break; }
+    }
+    if (!clash) {
+      width = (uint8_t)w;
+      height = (uint8_t)h;
