--- /dev/null
+++ b/wled00/bus_leafbus.cpp
@@ -0,0 +1,417 @@
+#ifdef ARDUINO_ARCH_ESP32
+// AI: below section was generated by an AI
+/*
+ * Nanoleaf Shapes panels as a WLED output (TYPE_LEAFBUS).
+ *
+ * Protocol reference: https://github.com/MyrikLD/LeafBus (PROTOCOL.md, MIT). Two points
+ * differ from that document and were verified on real panels:
+ *  - bulk pull (C0) replies come in layout-string order (first pair = nearest panel),
+ *    while bulk push (E0) chunks are reversed (first chunk = farthest panel)
+ *  - the panel hosting the power supply ORs 0x20 into its status byte
+ *
+ * Hardware: TX drives a tri-state buffer that is only enabled while TX is active, RX listens
+ * to the line through a second, always-enabled buffer. The controller therefore hears its own
+ * echo, which is checked and stripped. TX stays push-pull: the buffers release the line.
+ */
+#include "wled.h"
+#include "bus_manager.h"
+#include "driver/uart.h"
+#include "driver/gpio.h"
+#include "leafbus_geometry.h"
+
+static constexpr uint8_t  LB_ROOT_DETECT    = 0x00;   // panels note the connector facing the master
+static constexpr uint8_t  LB_LAYOUT_DETECT  = 0x80;   // reply: layout string ending in LB_TERMINATOR
+static constexpr uint8_t  LB_BULK_PULL      = 0xC0;   // reply: 2 status bytes per panel
+static constexpr uint8_t  LB_BULK_PUSH      = 0xE0;   // colour for every panel, no reply
+static constexpr uint8_t  LB_GLOBAL_CMD     = 0xFC;
+static constexpr uint8_t  LB_CMD_BRIGHTNESS = 0x04;
+static constexpr uint8_t  LB_TERMINATOR     = 0x40;
+static constexpr uint8_t  LB_HOTPLUG        = 0xCC;   // trailing byte of a pull reply after a change
+static constexpr uint8_t  LB_PSU_CODE       = 1;      // connector-count code of the power supply node
+static constexpr uint8_t  LB_TRANSITION     = 1;      // chunk fade time, as LeafBus uses for streaming
+static constexpr uint32_t LB_BAUD           = 1000000;
+static constexpr uint32_t LB_POLL_MS        = 50;     // stock cadence; unpolled panels apply only the first frame
+static constexpr uint32_t LB_MIN_FRAME_MS   = 25;     // at most 40 colour frames per second
+static constexpr uint32_t LB_RETRY_MS       = 5000;   // enumeration retry while nothing answers
+static constexpr uint32_t LB_REENUM_MS      = 2000;   // enumeration retry after a hot-plug
+static constexpr uint32_t LB_ECHO_MS        = 5;
+static constexpr uint32_t LB_LONG_WINDOW_MS = 1500;   // far panels can be slow to relay the layout
+static constexpr uint8_t  LB_MISS_LIMIT     = 20;     // unanswered polls before re-enumerating
+static constexpr uint8_t  LB_LAYOUT_TRIES   = 6;
+static constexpr uint16_t LB_MAX_PANELS     = 64;
+static constexpr size_t   LB_MAX_LAYOUT     = 256;
+static constexpr size_t   LB_RX_BUFFER      = 1024;
+static constexpr int      LB_EXPECT_TERMINATOR = -1;
+static constexpr char     LB_LEDMAP[]       = "/ledmap.json";
+static constexpr char     LB_MAP_MARK[]     = "\"generator\":\"nanoleaf-shapes\"";   // tags maps written here
+
+#if defined(SOC_UART_HP_NUM) && SOC_UART_HP_NUM > 2
+static constexpr uart_port_t LB_UART = UART_NUM_2;
+#else
+static constexpr uart_port_t LB_UART = UART_NUM_1;
+#endif
+
+BusLeafBus::BusLeafBus(const BusConfig &bc)
+: Bus(bc.type, bc.start, bc.autoWhite, bc.count, bc.reversed)
+, _text(bc.text)
+, _rotation(0)
+, _autoMap(true)
+, _data(nullptr)
+, _frame(nullptr)
+, _dirty(false)
+, _stop(false)
+, _pinsAllocated(false)
+, _uartInstalled(false)
+, _task(nullptr)
+, _lock(nullptr)
+, _stopped(nullptr)
+, _panels(0)
+, _hotplug(false)
+, _missRun(0)
+, _lastPoll(0)
+, _lastPush(0)
+, _nextEnum(0)
+, _layoutLen(0)
+, _mapDone(false)
+{
+  _hasRgb = true;
+  _hasWhite = true;
+  _hasCCT = false;
+  _pins[0] = bc.pins[0];
+  _pins[1] = bc.pins[1];
+  _text.trim();
+  _autoMap = !_text.equalsIgnoreCase(F("off"));
+  _rotation = ((_text.toInt() % 360) + 360) % 360;
+
+  managed_pin_type pins[2] = {{(int8_t)_pins[0], true}, {(int8_t)_pins[1], false}};
+  _pinsAllocated = PinManager::allocateMultiplePins(pins, 2, PinOwner::LeafBus);
+  if (!_pinsAllocated) return;
+
+  _data = (uint8_t*)d_calloc(_len, 4);
+  _frame = (uint8_t*)d_calloc(_len, 4);
+  _lock = xSemaphoreCreateMutex();
+  _stopped = xSemaphoreCreateBinary();
+  if (!_data || !_frame || !_lock || !_stopped) {
+    cleanup();
+    return;
+  }
+
+  uart_config_t cfg = {};
+  cfg.baud_rate = LB_BAUD;
+  cfg.data_bits = UART_DATA_8_BITS;
+  cfg.parity    = UART_PARITY_DISABLE;
+  cfg.stop_bits = UART_STOP_BITS_1;
+  cfg.flow_ctrl = UART_HW_FLOWCTRL_DISABLE;
+  #if ESP_IDF_VERSION_MAJOR >= 5
+  cfg.source_clk = UART_SCLK_DEFAULT;
+  #else
+  cfg.source_clk = UART_SCLK_APB;
+  #endif
+  _uartInstalled = uart_driver_install(LB_UART, LB_RX_BUFFER, 0, 0, nullptr, 0) == ESP_OK;
+  if (!_uartInstalled
+      || uart_param_config(LB_UART, &cfg) != ESP_OK
+      || uart_set_pin(LB_UART, _pins[0], _pins[1], UART_PIN_NO_CHANGE, UART_PIN_NO_CHANGE) != ESP_OK
+      || xTaskCreate(taskEntry, "LeafBus", 8192, this, 2, &_task) != pdPASS) {
+    _task = nullptr;
+    cleanup();
+    return;
+  }
+  _valid = true;
+  DEBUG_PRINTF_P(PSTR("LeafBus: TX %u, RX %u, %u pixels\n"), _pins[0], _pins[1], _len);
+}
+
+void BusLeafBus::cleanup() {
+  if (_task) {
+    _stop = true;
+    xTaskNotifyGive(_task);
+    // the task checks _stop between bus transactions; an enumeration step takes at most ~1.5 s
+    if (xSemaphoreTake(_stopped, pdMS_TO_TICKS(3000)) != pdTRUE) vTaskDelete(_task);
+    _task = nullptr;
+  }
+  if (_uartInstalled) {
+    uart_driver_delete(LB_UART);
+    _uartInstalled = false;
+  }
+  if (_pinsAllocated) {
+    // input with pull-up: TX idles high, so the transmit buffer stays disabled
+    gpio_reset_pin((gpio_num_t)_pins[0]);
+    gpio_reset_pin((gpio_num_t)_pins[1]);
+    PinManager::deallocateMultiplePins(_pins, 2, PinOwner::LeafBus);
+    _pinsAllocated = false;
+  }
+  if (_lock) vSemaphoreDelete(_lock);
+  if (_stopped) vSemaphoreDelete(_stopped);
+  _lock = _stopped = nullptr;
+  free(_data);
+  free(_frame);
+  _data = _frame = nullptr;
+  _valid = false;
+}
+
+void BusLeafBus::setPixelColor(unsigned pix, uint32_t c) {
+  if (!_valid || pix >= _len) return;
+  if (_reversed) pix = _len - 1 - pix;
+  uint8_t ww, cw; // dummy, unused
+  c = autoWhiteCalc(c, ww, cw);
+  if (Bus::_cct >= 1900) c = colorBalanceFromKelvin(Bus::_cct, c); //color correction from CCT
+  uint8_t *p = _data + pix * 4;
+  p[0] = R(c);
+  p[1] = G(c);
+  p[2] = B(c);
+  p[3] = W(c);
+}
+
+uint32_t BusLeafBus::getPixelColor(unsigned pix) const {
+  if (!_valid || pix >= _len) return 0;
+  if (_reversed) pix = _len - 1 - pix;
+  const uint8_t *p = _data + pix * 4;
+  return RGBW32(p[0], p[1], p[2], p[3]);
+}
+
+// Only hands the frame to the bus task, so a slow bus never stalls the effect loop.
+void BusLeafBus::show() {
+  if (!_valid || xSemaphoreTake(_lock, pdMS_TO_TICKS(20)) != pdTRUE) return;
+  const unsigned bri = _bri + 1;
+  for (unsigned i = 0; i < 4U * _len; i++) _frame[i] = (_data[i] * bri) >> 8;
+  _dirty = true;
+  xSemaphoreGive(_lock);
+  xTaskNotifyGive(_task);
+}
+
+size_t BusLeafBus::getPins(uint8_t* pinArray) const {
+  if (pinArray) {
+    pinArray[0] = _pins[0];
+    pinArray[1] = _pins[1];
+  }
+  return 2;
+}
+
+std::vector<LEDType> BusLeafBus::getLEDTypes() {
+  return {
+    {TYPE_LEAFBUS, "LL", PSTR("Nanoleaf Shapes")},   // 2 GPIO fields: TX, RX
+  };
+}
+
+void BusLeafBus::taskEntry(void *arg) {
+  static_cast<BusLeafBus*>(arg)->run();
+}
+
+void BusLeafBus::run() {
+  while (!_stop) {
+    ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(5)); // woken by show(), otherwise keeps the poll cadence
+    if (_stop) break;
+    uint32_t now = millis();
+    if (_panels == 0 || _hotplug) {
+      if ((int32_t)(now - _nextEnum) >= 0) {
+        enumerate();
+        _nextEnum = millis() + (_panels ? LB_REENUM_MS : LB_RETRY_MS);
+      }
+      continue;
+    }
+    if (_dirty && now - _lastPush >= LB_MIN_FRAME_MS) push();
+    if (now - _lastPoll >= LB_POLL_MS) poll();
+  }
+  xSemaphoreGive(_stopped);
+  vTaskDelete(nullptr);
+}
+
+// Transmit a frame and consume its echo. Returns false if the echo was not our frame.
+bool BusLeafBus::send(const uint8_t *frame, size_t len) {
+  uint8_t echo[32];
+  size_t got = 0;
+  bool ok = true;
+  uart_flush_input(LB_UART);
+  uart_write_bytes(LB_UART, frame, len);
+  uart_wait_tx_done(LB_UART, pdMS_TO_TICKS(20));
+  uint32_t start = millis();
+  while (got < len && millis() - start < LB_ECHO_MS + len / 100) {
+    int n = uart_read_bytes(LB_UART, echo, std::min(len - got, sizeof(echo)), pdMS_TO_TICKS(1));
+    if (n <= 0) continue;
+    ok = ok && memcmp(echo, frame + got, n) == 0;
+    got += n;
+  }
+  return ok && got == len;
+}
+
+// Read a reply until `expect` bytes, the layout terminator or the deadline.
+size_t BusLeafBus::receive(uint8_t *buf, size_t max, int expect, uint32_t waitMs) {
+  size_t limit = (expect > 0 && (size_t)expect < max) ? expect : max;
+  size_t n = 0;
+  uint32_t start = millis();
+  while (n < limit && millis() - start < waitMs && !_stop) {
+    int r = uart_read_bytes(LB_UART, buf + n, limit - n, pdMS_TO_TICKS(1));
+    if (r <= 0) continue;
+    n += r;
+    if (expect == LB_EXPECT_TERMINATOR && memchr(buf, LB_TERMINATOR, n)) break;
+  }
+  return n;
+}
+
+// Root detect, then layout detect until the same string is read twice: the head of the
+// string can arrive corrupted on big assemblies. Pixel order follows the panel nodes in it.
+void BusLeafBus::enumerate() {
+  static const uint8_t rootDetect[]   = {LB_ROOT_DETECT};
+  static const uint8_t layoutDetect[] = {LB_LAYOUT_DETECT};
+  static const uint8_t fullBright[]   = {LB_GLOBAL_CMD, LB_CMD_BRIGHTNESS, 0xFF};
+  uint8_t cur[LB_MAX_LAYOUT], last[LB_MAX_LAYOUT];
+  size_t lastLen = 0;
+  bool stable = false;
+
+  for (unsigned i = 0; i < LB_LAYOUT_TRIES && !stable && !_stop; i++) {
+    send(rootDetect, sizeof(rootDetect));
+    vTaskDelay(pdMS_TO_TICKS(20));
+    send(layoutDetect, sizeof(layoutDetect));
+    size_t n = receive(cur, sizeof(cur), LB_EXPECT_TERMINATOR, 200 + 40 * (_panels ? _panels : 1));
+    if (n == 0) break; // silent: nothing plugged in, or the panels are still starting up
+    const uint8_t *end = (const uint8_t*)memchr(cur, LB_TERMINATOR, n);
+    if (!end) {
+      n += receive(cur + n, sizeof(cur) - n, LB_EXPECT_TERMINATOR, LB_LONG_WINDOW_MS);
+      end = (const uint8_t*)memchr(cur, LB_TERMINATOR, n);
+      if (!end) continue;
+    }
+    n = end - cur + 1;
+    stable = (n == lastLen && memcmp(cur, last, n) == 0);
+    memcpy(last, cur, n);
+    lastLen = n;
+  }
+
+  uint16_t panels = 0;
+  for (size_t i = 0; i + 1 < lastLen; i++) { // the terminator is not a node
+    uint8_t b = last[i];
+    if ((b & 0x80) && ((b >> 4) & 7) != LB_PSU_CODE && panels < LB_MAX_PANELS) panels++;
+  }
+  if (panels != _panels) {
+    DEBUG_PRINTF_P(PSTR("LeafBus: %u panel(s)%s\n"), panels, stable || !panels ? "" : " (layout unstable)");
+  }
+  if (stable && panels && (lastLen != _layoutLen || memcmp(last, _layout, lastLen) != 0)) {
+    memcpy(_layout, last, lastLen);
+    _layoutLen = lastLen;
+    _mapDone = false;
+  }
+  _panels = panels;
+  _hotplug = false;
+  _missRun = 0;
+  if (!_panels) return;
+
+  send(fullBright, sizeof(fullBright)); // WLED scales brightness itself; undo any dimming left by the stock controller
+  if (xSemaphoreTake(_lock, pdMS_TO_TICKS(20)) == pdTRUE) {
+    _dirty = true; // show the current frame on the (re)found panels
+    xSemaphoreGive(_lock);
+  }
+  _lastPoll = millis();
+  if (!_mapDone && _layoutLen) updateLedmap();
+}
+
+// Keep /ledmap.json in step with the physical layout, so WLED's 2D effects follow the wall: one matrix
+// cell per panel, placed with the LeafBus geometry, gaps elsewhere. A missing map or one written here is
+// replaced; a hand-made one is left alone. Applied live, the same way the 2D settings page does it.
+void BusLeafBus::updateLedmap() {
+  _mapDone = true;
+  if (!_autoMap) return;
+  leafbus::Panel panels[leafbus::MAX_PANELS];
+  uint16_t cells[leafbus::MAX_PANELS];
+  uint8_t width = 0, height = 0;
+  int n = leafbus::parseLayout(_layout, _layoutLen - 1, panels, leafbus::MAX_PANELS);
+  if (n <= 0 || !leafbus::placePanels(panels, n) || !leafbus::gridPanels(panels, n, _rotation, width, height, cells)) {
+    DEBUG_PRINTLN(F("LeafBus: layout not mappable to 2D"));
+    return;
+  }
+
+  String json;
+  json.reserve(128 + 2 * _layoutLen + 4U * width * height);
+  json += F("{\"n\":\"Nanoleaf Shapes\",");
+  json += LB_MAP_MARK;
+  json += F(",\"rot\":");
+  json += _rotation;
+  json += F(",\"layout\":\"");
+  for (size_t i = 0; i < _layoutLen; i++) {
+    char hex[3];
+    snprintf_P(hex, sizeof(hex), PSTR("%02X"), _layout[i]);
+    json += hex;
+  }
+  json += F("\",\"width\":");
+  json += width;
+  json += F(",\"height\":");
+  json += height;
+  json += F(",\"map\":["); // must stay the last key: WLED streams the numbers after it
+  for (unsigned cell = 0; cell < (unsigned)width * height; cell++) {
+    int led = -1;
+    for (int i = 0; i < n; i++) if (cells[i] == cell) { led = i; break; }
+    if (cell) json += ',';
+    json += led;
+  }
+  json += F("]}");
+
+  if (WLED_FS.exists(LB_LEDMAP)) {
+    File f = WLED_FS.open(LB_LEDMAP, "r");
+    String old = f ? f.readString() : String();
+    f.close();
+    if (old == json) return; // already matches this layout
+    if (old.indexOf(LB_MAP_MARK) < 0) {
+      DEBUG_PRINTLN(F("LeafBus: keeping the hand-made /ledmap.json"));
+      return;
+    }
+  }
+  File f = WLED_FS.open(LB_LEDMAP, "w");
+  if (!f) return;
+  f.print(json);
+  f.close();
+
+  strip.suspend();
+  strip.waitForIt();
+  strip.deserializeMap();       // picks up width and height as well
+  strip.makeAutoSegments(true); // segments must span the new matrix
+  strip.resume();
+  DEBUG_PRINTF_P(PSTR("LeafBus: 2D map %ux%u for %d panels\n"), width, height, n);
+}
+
+void BusLeafBus::poll() {
+  static const uint8_t pull[] = {LB_BULK_PULL};
+  uint8_t reply[2 * LB_MAX_PANELS + 1];
+  const size_t expect = 2 * _panels;
+
+  send(pull, sizeof(pull));
+  size_t n = receive(reply, sizeof(reply), expect, 40 + 20 * _panels);
+  if (n == expect) n += receive(reply + n, 1, 1, 2); // a hot-plug marker follows the pairs
+  _lastPoll = millis();
+
+  if (n > 0 && reply[n - 1] == LB_HOTPLUG && (n - 1) % 2 == 0) {
+    _hotplug = true; // re-enumerate: moved panels silently stop applying colour until we do
+    return;
+  }
+  if (n < expect) {
+    if (++_missRun >= LB_MISS_LIMIT) _panels = 0; // assembly gone or restarted: enumerate again
+  } else {
+    _missRun = 0;
+  }
+}
+
+// Chunks run from the far end: chunk i drives the panel at layout position N-1-i.
+void BusLeafBus::push() {
+  uint8_t frame[2 + 6 * LB_MAX_PANELS];
+  size_t len = 0;
+  if (xSemaphoreTake(_lock, pdMS_TO_TICKS(20)) != pdTRUE) return;
+  frame[len++] = LB_BULK_PUSH;
+  frame[len++] = 0x03; // constant in every observed frame
+  for (unsigned chunk = 0; chunk < _panels; chunk++) {
+    unsigned pos = _panels - 1 - chunk;
+    if (pos >= _len) { // more panels than configured pixels: leave the rest unchanged
+      frame[len++] = 0x01;
+      frame[len++] = 0xFF;
+      continue;
+    }
+    const uint8_t *p = _frame + pos * 4;
+    frame[len++] = 0x05; // chunk length
+    frame[len++] = LB_TRANSITION;
+    frame[len++] = p[0];
+    frame[len++] = p[1];
+    frame[len++] = p[2];
+    frame[len++] = p[3];
+  }
+  _dirty = false;
+  xSemaphoreGive(_lock);
+  send(frame, len);
+  _lastPush = millis();
+}
+// AI: end
+#endif
